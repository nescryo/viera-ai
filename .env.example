# Viera AI Environment Variables
# Copy this file to .env and fill in the values below.
# LLM and TTS API keys are entered in the in-app Settings, not here.
#
# Supabase Auth & optional cloud chat sync (optional: skip to use "Continue as guest").
# Use either local Supabase CLI (`http://127.0.0.1:54321`) or a Supabase Cloud project URL.
# These VITE_ values are public browser configuration. Never use a secret/service_role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Optional: OAuth secrets for local Supabase CLI only (uncomment matching blocks in supabase/config.toml).
# Never prefix OAuth secrets with VITE_, or Vite will inline them into the browser bundle.
# SUPABASE_AUTH_GITHUB_CLIENT_ID=your-github-client-id
# SUPABASE_AUTH_GITHUB_SECRET=your-github-client-secret
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=your-google-client-id
# SUPABASE_AUTH_GOOGLE_SECRET=your-google-client-secret

# For Benchmark
BENCHMARK_API_URL=http://xxxxxxx/v1
BENCHMARK_API_KEY=sk-your-ai-api-key-here
BENCHMARK_MODEL=your-model-here
