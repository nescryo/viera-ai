# Viera AI Environment Variables
# Copy this file to .env and fill in the values below.
# LLM and TTS API keys are entered in the in-app Settings, not here.
# Supabase Auth (GitHub and Google providers). These values are public browser configuration.
# Never use a Supabase secret/service_role key or OAuth client secrets here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

#For Benchmark
BENCHMARK_API_URL=http://xxxxxxx/v1
BENCHMARK_API_KEY=sk-your-ai-api-key-here
BENCHMARK_MODEL=your-model-here


